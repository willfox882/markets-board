<?xml version="1.0" encoding="utf-8"?>
<!-- Markets Board launcher glyph: one thin line chart, a baseline and the last-price dot, matte off-white on near-black
     (same palette and weight as the Truck Dash gauge). Everything sits inside the 66 dp adaptive-icon safe zone and is
     centred; the same shape is the monochrome (themed) icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateY="2.5">
        <!-- baseline -->
        <path
            android:fillColor="#F2F2F4"
            android:pathData="M30,70 L78,70 L78,72.5 L30,72.5 Z" />
        <!-- thin line chart: up, dip, up, up -->
        <path
            android:strokeColor="#F2F2F4"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M31,62 L43,50 L52,57 L64,40 L74,35" />
        <!-- last-price dot -->
        <path
            android:fillColor="#F2F2F4"
            android:pathData="M74,30.5 A4.5,4.5 0 1 1 74,39.5 A4.5,4.5 0 1 1 74,30.5 Z" />
    </group>
</vector>
